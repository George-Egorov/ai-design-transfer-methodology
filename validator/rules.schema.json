{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poliklot.github.io/bridge-design-methodology/schema/rules.schema.json",
  "title": "BRIDGE validator rule catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "methodology", "version", "severityLevels", "automationLevels", "rules"],
  "properties": {
    "$schema": { "const": "./rules.schema.json" },
    "methodology": { "const": "BRIDGE" },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "severityLevels": { "const": ["error", "warning", "info"] },
    "automationLevels": { "const": ["automatic", "heuristic", "manual"] },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "principle", "severity", "automation", "description", "fix"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" },
          "principle": { "enum": ["Breakpoints", "Roles", "Identity", "Dependencies", "Geometry", "Exceptions"] },
          "severity": { "enum": ["error", "warning", "info"] },
          "automation": { "enum": ["automatic", "heuristic", "manual"] },
          "description": { "type": "string", "minLength": 20 },
          "fix": { "type": "string", "minLength": 20 }
        }
      }
    }
  }
}
