      },
      "status": "experimental",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "field"
      ],
      "form": "property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
