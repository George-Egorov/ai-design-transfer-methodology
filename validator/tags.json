{
  "$schema": "./tags.schema.json",
  "methodology": "BRIDGE",
  "schemaVersion": "1.0.0",
  "description": "Canonical registry of BRIDGE layer-name tags and the boundary with structured Figma metadata and namespaced bridge contracts.",
  "statusLevels": [
    "stable",
    "experimental",
    "deprecated"
  ],
  "scopeLevels": [
    "page-root",
    "variant-root",
    "layer",
    "control",
    "field",
    "target",
    "collection",
    "item"
  ],
  "sourceOfTruthLevels": [
    "bridge-tag",
    "figma-metadata"
  ],
  "structuredMetadata": {
    "namespace": "bridge",
    "schema": "./bridge.schema.json",
    "rule": "Use layer tags only for compact transfer intent and identity anchors. Put data, responsive transformations, interaction graphs, motion, accessibility, and delivery lifecycle in the namespaced structured contract."
  },
  "tags": [
    {
      "key": "page",
      "title": {
        "en": "Page identity",
        "ru": "Идентификатор страницы"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "page-root"
      ],
      "form": "property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": true,
      "companions": {
        "requires": [
          "bp",
          "view"
        ]
      },
      "notes": {
        "en": "A BRIDGE page root always uses native Auto Layout and must never carry [asset]. It may sit directly on the Figma page or below native Figma SECTION canvas organizers; those organizers are transparent and contribute no BRIDGE context.",
        "ru": "Корень страницы BRIDGE всегда использует нативный Auto Layout и никогда не содержит [asset]. Он может лежать прямо на странице Figma или под нативными организаторами SECTION Figma; такие организаторы прозрачны и не передают контекст BRIDGE."
      }
    },
    {
      "key": "route",
      "title": {
        "en": "Production route",
        "ru": "Рабочий маршрут"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "page-root"
      ],
      "form": "property",
      "value": {
        "kind": "route",
        "pattern": "^/(?:[^\\s?#]+/?)*(?:#[a-z0-9]+(?:-[a-z0-9]+)*)?$"
      },
      "identityBearing": false,
      "companions": {
        "requires": [
          "page"
        ],
        "conflicts": [
          "route-pattern"
        ]
      }
    },
    {
      "key": "route-pattern",
      "title": {
        "en": "Dynamic route pattern",
        "ru": "Шаблон динамического маршрута"
      },
      "status": "experimental",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "page-root"
      ],
      "form": "property",
      "value": {
        "kind": "route-pattern",
        "pattern": "^/(?:[^\\s?#]+/?)*:[a-z][a-z0-9-]*(?:/(?:[^\\s?#]+|:[a-z][a-z0-9-]*))*$"
      },
      "identityBearing": false,
      "companions": {
        "requires": [
          "page"
        ],
        "conflicts": [
          "route"
        ]
      }
    },
    {
      "key": "bp",
      "title": {
        "en": "Control width",
        "ru": "Контрольная ширина"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "page-root"
      ],
      "form": "property",
      "value": {
        "kind": "positive-integer",
        "pattern": "^[1-9][0-9]*$"
      },
      "identityBearing": false,
      "companions": {
        "requires": [
          "page"
        ]
      }
    },
    {
      "key": "view",
      "title": {
        "en": "Page view",
        "ru": "Вид страницы"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "page-root"
      ],
      "form": "property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": false,
      "companions": {
        "requires": [
          "page"
        ]
      }
    },
    {
      "key": "anchor",
      "title": {
        "en": "Anchor target",
        "ru": "Цель якоря"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "layer"
      ],
      "form": "property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": true,
      "companions": {}
    },
    {
      "key": "section",
      "title": {
        "en": "Page section identity",
        "ru": "Идентификатор секции"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "layer"
      ],
      "form": "property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": true,
      "companions": {
        "conflicts": [
          "modal",
          "state",
          "field",
          "collection",
          "item",
          "form"
        ]
      },
      "notes": {
        "en": "A stable [section] value is the required boundary for Check selected section; never add page/bp/view/route tags to a section. A frame-built section or editable Page Sections source root uses native Auto Layout unless that exact selected root also carries [asset] and is a genuine opaque whole visual. A section nested below a different non-page-root opaque [asset] ancestor is an invalid blocked selection because the audit cannot pierce the inherited boundary. An invalid [asset] on a page root never creates opacity. Placed INSTANCE nodes are atomic and their source is audited separately.",
        "ru": "Стабильное значение [section] является обязательной границей для проверки выбранной секции; теги page/bp/view/route нельзя добавлять секции. Секция-фрейм или редактируемый исходный корень Page Sections использует нативный Auto Layout, кроме случая, когда сам выбранный корень также содержит [asset] и является настоящим непрозрачным цельным визуальным ресурсом. Секция под другим непрозрачным родительским [asset], не являющимся корнем страницы, является недопустимым заблокированным выбором: проверка не проходит сквозь унаследованную границу. Недопустимый [asset] на корне страницы никогда не создаёт непрозрачность. Размещённые INSTANCE атомарны, а их источник проверяется отдельно."
      }
    },
    {
      "key": "href",
      "title": {
        "en": "Navigation destination",
        "ru": "Адрес перехода"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "layer",
        "control"
      ],
      "form": "property",
      "value": {
        "kind": "href",
        "pattern": "^(?:/(?!/)[^\\s]*|#[a-z0-9]+(?:-[a-z0-9]+)*|https?://[^\\s]+|mailto:[^\\s@]+@[^\\s@]+|tel:\\+?[0-9() .-]+)$"
      },
      "identityBearing": false,
      "companions": {
        "conflicts": [
          "action"
        ]
      }
    },
    {
      "key": "link",
      "title": {
        "en": "Draft link or advanced link identity",
        "ru": "Черновая ссылка или расширенный идентификатор ссылки"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "layer",
        "control"
      ],
      "form": "boolean-or-property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": true,
      "companions": {
        "conflicts": [
          "action",
          "control"
        ]
      },
      "notes": {
        "en": "Prefer [href=...] when the destination is known; the value form is an advanced override.",
        "ru": "Когда адрес известен, используйте [href=...]; форма со значением предназначена только для расширенного переопределения."
      }
    },
    {
      "key": "open",
      "title": {
        "en": "Link opening behavior",
        "ru": "Способ открытия ссылки"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "control"
      ],
      "form": "property",
      "value": {
        "kind": "enum",
        "enum": [
          "new-tab"
        ]
      },
      "identityBearing": false,
      "companions": {
        "requiresAny": [
          "href",
          "link"
        ]
      }
    },
    {
      "key": "a11y-label",
      "title": {
        "en": "Accessible control label",
        "ru": "Доступное название элемента управления"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "control"
      ],
      "form": "property",
      "value": {
        "kind": "human-text",
        "minLength": 1
      },
      "identityBearing": false,
      "companions": {
        "requiresAny": [
          "href",
          "link",
          "action",
          "control"
        ]
      }
    },
    {
      "key": "action",
      "title": {
        "en": "Non-navigation action",
        "ru": "Ненавигационное действие"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "control"
      ],
      "form": "property",
      "value": {
        "kind": "action",
        "pattern": "^(?:modal|state|submit|reset):[a-z0-9]+(?:-[a-z0-9]+)*$|^none$"
      },
      "identityBearing": false,
      "companions": {
        "conflicts": [
          "href",
          "link"
        ]
      }
    },
    {
      "key": "control",
      "title": {
        "en": "Draft control or advanced control identity",
        "ru": "Черновой элемент управления или его расширенный идентификатор"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "control"
      ],
      "form": "boolean-or-property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": true,
      "companions": {
        "conflicts": [
          "href",
          "link"
        ]
      },
      "notes": {
        "en": "Prefer [action=...] when behavior is known; the value form is an advanced override.",
        "ru": "Когда действие известно, используйте [action=...]; форма со значением предназначена только для расширенного переопределения."
      }
    },
    {
      "key": "field",
      "title": {
        "en": "Field identity",
        "ru": "Идентификатор поля"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "field"
      ],
      "form": "property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": true,
      "companions": {
        "requires": [
          "name"
        ],
        "conflicts": [
          "form"
        ]
      }
    },
    {
      "key": "name",
      "title": {
        "en": "Data binding name",
        "ru": "Имя привязки данных"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "field"
      ],
      "form": "property",
      "value": {
        "kind": "field-name",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "identityBearing": false,
      "companions": {
        "requires": [
          "field"
        ]
      }
    },
    {
      "key": "field-type",
      "title": {
        "en": "Field type override",
        "ru": "Переопределение типа поля"
      },
      "status": "experimental",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "field"
      ],
      "form": "property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": false,
      "companions": {
        "requires": [
          "field"
        ]
      }
    },
    {
      "key": "form",
      "title": {
        "en": "Form target identity",
        "ru": "Идентификатор формы"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "target"
      ],
      "form": "property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": true,
      "companions": {
        "conflicts": [
          "section",
          "modal",
          "state",
          "field",
          "collection",
          "item"
        ]
      }
    },
    {
      "key": "modal",
      "title": {
        "en": "Modal target identity",
        "ru": "Идентификатор модального окна"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "target"
      ],
      "form": "property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": true,
      "companions": {
        "conflicts": [
          "section",
          "state",
          "field",
          "collection",
          "item",
          "form"
        ]
      }
    },
    {
      "key": "state",
      "title": {
        "en": "State target identity",
        "ru": "Идентификатор состояния"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "target"
      ],
      "form": "property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": true,
      "companions": {
        "conflicts": [
          "section",
          "modal",
          "field",
          "collection",
          "item",
          "form"
        ]
      }
    },
    {
      "key": "collection",
      "title": {
        "en": "Collection identity",
        "ru": "Идентификатор коллекции"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "collection"
      ],
      "form": "property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": true,
      "companions": {
        "conflicts": [
          "section",
          "modal",
          "state",
          "field",
          "item",
          "form"
        ]
      }
    },
    {
      "key": "item",
      "title": {
        "en": "Repeated role or type",
        "ru": "Роль или тип повторяющегося элемента"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "item"
      ],
      "form": "property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": false,
      "companions": {
        "conflicts": [
          "section",
          "modal",
          "state",
          "field",
          "collection",
          "form"
        ]
      },
      "notes": {
        "en": "The value classifies a repeated role or type; stable design-instance and runtime-data identities remain separate.",
        "ru": "Значение классифицирует повторяемую роль или тип; стабильные идентификаторы экземпляра макета и рабочих данных задаются отдельно."
      }
    },
    {
      "key": "decor",
      "title": {
        "en": "Decorative intent",
        "ru": "Декоративное назначение"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "layer"
      ],
      "form": "boolean-or-property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": false,
      "companions": {},
      "notes": {
        "en": "Prefer the boolean form with a stable layer name. Outside an asset, [decor] belongs only on the exact intended absolute visual node and never exempts a container or GROUP from structural rules.",
        "ru": "Предпочитайте булеву форму со стабильным именем слоя. Вне ресурса [decor] ставится только на точный намеренный абсолютный визуальный узел и никогда не освобождает контейнер или GROUP от структурных правил."
      }
    },
    {
      "key": "asset",
      "title": {
        "en": "Whole-export policy",
        "ru": "Политика цельного экспорта"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "layer"
      ],
      "form": "boolean-or-property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": false,
      "companions": {},
      "notes": {
        "en": "Prefer the boolean form with a stable layer name. An asset is one opaque visual subtree whose root remains in the parent flow; [decor] and [asset] may be combined. Page roots cannot be assets.",
        "ru": "Предпочитайте булеву форму со стабильным именем слоя. Ресурс является одним непрозрачным визуальным поддеревом, чей корень остаётся в потоке родителя; [decor] и [asset] можно сочетать. Корень страницы не может быть ресурсом."
      }
    },
    {
      "key": "height",
      "title": {
        "en": "Dynamic height policy",
        "ru": "Политика динамической высоты"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "layer"
      ],
      "form": "property",
      "value": {
        "kind": "enum",
        "enum": [
          "hug",
          "fixed",
          "min",
          "fill"
        ]
      },
      "identityBearing": false,
      "companions": {
        "recommendedWhen": {
          "value": "fixed",
          "any": [
            "overflow",
            "reason"
          ]
        }
      }
    },
    {
      "key": "overflow",
      "title": {
        "en": "Overflow policy",
        "ru": "Политика переполнения"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "layer"
      ],
      "form": "property",
      "value": {
        "kind": "enum",
        "enum": [
          "visible",
          "hidden",
          "scroll",
          "truncate"
        ]
      },
      "identityBearing": false,
      "companions": {}
    },
    {
      "key": "lines",
      "title": {
        "en": "Maximum visible lines",
        "ru": "Максимум видимых строк"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "layer"
      ],
      "form": "property",
      "value": {
        "kind": "positive-integer",
        "pattern": "^[1-9][0-9]*$"
      },
      "identityBearing": false,
      "companions": {
        "requiresValue": {
          "key": "overflow",
          "value": "truncate"
        }
      }
    },
    {
      "key": "bridge-exception",
      "title": {
        "en": "Documented transfer exception",
        "ru": "Объявленное исключение переноса"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "layer",
        "page-root"
      ],
      "form": "property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": false,
      "companions": {
        "requires": [
          "reason"
        ]
      },
      "notes": {
        "en": "Overlay may satisfy exact-node absolute positioning intent. Manual-layout documents a proposed structural deviation but does not suppress page, section, container, or GROUP errors.",
        "ru": "Overlay может подтвердить назначение точного абсолютного узла. Manual-layout документирует предлагаемое структурное отклонение, но не подавляет ошибки страницы, секции, контейнера или GROUP."
      }
    },
    {
      "key": "reason",
      "title": {
        "en": "Machine-readable reason",
        "ru": "Машиночитаемая причина"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "layer",
        "page-root"
      ],
      "form": "property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": false,
      "companions": {
        "requiresAny": [
          "bridge-exception",
          "height"
        ]
      }
    },
    {
      "key": "locale",
      "title": {
        "en": "Locale variation axis",
        "ru": "Ось языка и региона"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "page-root",
        "variant-root"
      ],
      "form": "property",
      "value": {
        "kind": "locale",
