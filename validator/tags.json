        "ru": "Идентификатор состояния",
        "zh": "陈述目标身份"
      },
      "status": "stable",
      "authoredInLayerName": true,
      "sourceOfTruth": "bridge-tag",
      "scope": [
        "target"
      ],
      "form": "property",
      "value": {
        "kind": "kebab-case",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "identityBearing": true,
      "companions": {
        "conflicts": [
          "section",
