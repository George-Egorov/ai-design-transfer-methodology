    "openQuestion": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "question",
        "owner",
        "blocking",
        "status",
        "fallback"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
