        "question": {
          "$ref": "#/$defs/nonEmpty"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "blocking": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "open",
            "investigating",
            "answered",
            "deferred",
            "closed"
          ]
        },
        "due": {
          "type": "string",
          "format": "date"
        },
        "reviewAt": {
          "$ref": "#/$defs/nonEmpty"
        },
        "fallback": {
          "$ref": "#/$defs/nonEmpty"
        },
        "decisionLink": {
          "$ref": "#/$defs/uriReference"
        },
        "scope": {
          "$ref": "#/$defs/refList"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "open",
                  "investigating",
                  "deferred"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "due"
                ]
              },
              {
                "required": [
                  "reviewAt"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "answered",
                  "closed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "decisionLink"
            ]
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "scopeRef"
          ]
        },
        {
          "required": [
            "scope"
          ]
        }
      ]
    },
