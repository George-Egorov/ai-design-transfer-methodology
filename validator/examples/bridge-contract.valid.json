    "structure": {
      "contexts": [
        {
          "id": "desktop",
          "rootIdentity": "catalog-page",
          "tree": {
            "identity": "catalog-page",
            "children": [
              "product-grid",
              "revenue-chart",
              "revenue-table",
              "filter-dialog",
              "story-visual"
            ]
          }
        },
        {
          "id": "mobile",
          "rootIdentity": "catalog-page",
          "tree": {
            "identity": "catalog-page",
            "children": [
              "product-grid",
              "filter-dialog"
            ]
          }
        }
      ]
    },
    "data": {
      "displays": [
        {
          "displayId": "revenue-chart",
          "purpose": "Compare recognized revenue with target by month",
          "source": {
            "owner": "finance-analytics",
            "dataset": "recognized-revenue",
            "refresh": "daily",
            "staleAfter": "PT36H"
          },
          "dimensions": [
            {
              "key": "month",
              "type": "year-month",
              "timeZone": "UTC"
            }
          ],
          "measures": [
            {
              "key": "actual",
              "type": "decimal",
              "currency": "USD",
              "aggregation": "sum"
            }
          ],
          "format": {
            "locale": "user",
            "maximumFractionDigits": 1
          },
          "states": [
            "loading",
            "empty",
            "error",
            "partial",
            "stale"
          ],
          "accessibleEquivalent": "revenue-table"
        }
      ]
    },
    "responsive": {
      "defaultPolicy": "same-tree",
      "contexts": [
        {
          "id": "desktop",
          "driver": "viewport",
          "width": 1440
        },
        {
          "id": "mobile",
          "driver": "viewport",
          "width": 375
        }
      ],
      "transformations": [
        {
          "id": "product-grid-to-list",
          "fromContext": "desktop",
          "toContext": "mobile",
          "when": {
            "driver": "viewport",
            "condition": "width < 768px"
          },
          "mappings": [
            {
              "source": [
                "product-grid"
              ],
              "target": [
                "product-grid"
              ],
              "semantics": "Same product collection rendered as a one-column list"
            }
          ],
          "preserves": [
            "content",
            "actions",
            "selection",
            "filters"
          ],
          "focusOrder": [
            "product-grid"
          ],
          "readingOrder": [
            "product-grid"
          ],
          "stateTransfer": {
            "selection": "preserve"
          },
          "history": {
            "url": "preserve"
          }
        }
      ]
    },
    "interaction": {
      "stateMachines": [
        {
          "id": "filters",
          "scope": "filter-dialog",
          "initial": "closed",
          "states": [
            "closed",
            "open",
            "applying",
            "failed"
          ],
          "transitions": [
            {
              "id": "open-filters",
              "from": "closed",
              "event": "activate-filter-control",
              "to": "open",
              "effects": [
                {
                  "type": "show",
                  "target": "filter-dialog"
                }
              ],
              "focus": {
                "initial": "first-field"
              }
            },
            {
              "id": "apply-filters",
              "from": "open",
              "event": "submit-filters",
              "pending": {
                "to": "applying"
              },
              "outcomes": [
                {
                  "when": "success",
                  "to": "closed"
                },
                {
                  "when": "error",
                  "to": "failed"
                }
              ],
              "concurrency": {
                "policy": "latest-wins"
              }
            }
          ]
        }
      ]
    },
    "motion": {
      "sequences": [
        {
          "sequenceId": "feature-story-scroll",
          "purpose": "Explain the workflow in three stable scenes",
          "driver": {
            "type": "scroll-progress",
            "source": "document",
            "range": {
              "start": "block-start 80%",
              "end": "block-end 20%"
            }
          },
          "scenes": [
            {
              "id": "intro",
              "content": "story-visual"
            }
          ],
          "reentry": "derive-from-current-progress",
          "reverse": "mirror",
          "interruption": "derive-from-current-progress",
          "reducedMotion": "show-all-scenes-in-document-order",
          "fallback": "render-all-scenes-in-normal-flow"
        }
      ]
    },
    "accessibility": {
      "profile": {
