{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poliklot.github.io/bridge-design-methodology/schema/methodology-coverage.schema.json",
  "title": "Expanded BRIDGE methodology validation coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "catalogVersion", "description", "areas"],
  "properties": {
    "$schema": { "const": "./methodology-coverage.schema.json" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "catalogVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string", "minLength": 40 },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "checks"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "ru"],
            "properties": {
              "en": { "type": "string", "pattern": "^docs/.+\\.md$" },
              "ru": { "type": "string", "pattern": "^docs/ru/.+\\.md$" }
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["concern", "level", "ruleIds"],
              "properties": {
                "concern": { "type": "string", "minLength": 20 },
                "level": { "enum": ["automatic", "heuristic", "manual"] },
                "ruleIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" }
                }
              }
            }
          }
        }
      }
    }
  }
}
