---
import catalog from '../../validator/rules.json';
import ruRules from '../data/rules.ru.json';
import zhRules from '../data/rules.zh.json';

interface Props {
  locale: 'ru' | 'en' | 'zh';
}

const { locale } = Astro.props;

const principleRu: Record<string, string> = {
  Breakpoints: 'Адаптивы',
  Roles: 'Назначение',
  Identity: 'Идентификаторы',
  Dependencies: 'Связи',
  Geometry: 'Геометрия',
  Exceptions: 'Исключения',
};

const severityRu: Record<string, string> = {
  error: 'Ошибка',
  warning: 'Предупреждение',
  info: 'Справка',
};

const automationRu: Record<string, string> = {
  automatic: 'Автоматически',
  heuristic: 'Эвристически',
  manual: 'Вручную',
};

const principleZh: Record<string, string> = {
  Breakpoints: '断点', Roles: '角色', Identity: '标识', Dependencies: '依赖', Geometry: '几何', Exceptions: '例外',
};

const severityZh: Record<string, string> = { error: '错误', warning: '警告', info: '说明' };
const automationZh: Record<string, string> = { automatic: '自动', heuristic: '启发式', manual: '手动' };

const humanize = (id: string) => {
  const text = id.split('.').at(-1)?.replaceAll('-', ' ') || id;
  return text.charAt(0).toUpperCase() + text.slice(1);
};

const russianSearchAliases = (id: string) => [
  id.includes('modal') && 'модальное окно модалка',
  /(responsive|breakpoint)/u.test(id) && 'адаптив контрольная ширина',
  /(text|content)/u.test(id) && 'текст содержимое контент',
  /(interaction|action|href|link)/u.test(id) && 'ссылка действие интерактивность',
  /(identity|naming)/u.test(id) && 'идентификатор имя название',
  /(layout|wrapper)/u.test(id) && 'структура обёртка',
  id.includes('component') && 'компонент библиотека',
  /(route|routing)/u.test(id) && 'маршрут страница адрес',
  /(asset|image|media)/u.test(id) && 'изображение ресурс экспорт',
  /(overflow|height)/u.test(id) && 'переполнение высота',
].filter(Boolean).join(' ');

const chineseSearchAliases = (id: string) => [
  id.includes('modal') && '模态框 弹窗',
  /(responsive|breakpoint)/u.test(id) && '响应式 断点',
  /(text|content)/u.test(id) && '文本 内容',
  /(interaction|action|href|link)/u.test(id) && '交互 链接 动作',
  /(identity|naming)/u.test(id) && '标识 命名',
  /(layout|wrapper)/u.test(id) && '布局 容器',
  id.includes('component') && '组件',
  /(route|routing)/u.test(id) && '路由 页面 地址',
  /(asset|image|media)/u.test(id) && '图片 资源',
  /(overflow|height)/u.test(id) && '溢出 高度',
].filter(Boolean).join(' ');

const copy = locale === 'ru'
  ? {
      eyebrow: 'Открытый каталог',
      title: 'Каталог правил валидатора',
      lead: `Найдите, почему макет не проходит проверку и что именно исправить. В каталоге ${catalog.rules.length} правил с постоянными идентификаторами, серьёзностью и способом проверки.`,
      search: 'Поиск по правилу',
      searchPlaceholder: 'Например: модальное окно, адаптив…',
      severityLabel: 'Серьёзность',
      automationLabel: 'Способ проверки',
      severity: 'Любая серьёзность',
      automation: 'Любая проверка',
      shown: 'Показано',
      of: 'из',
      loadMore: 'Показать ещё',
      canonical: 'Почему это мешает передаче',
      fix: 'Как исправить',
      empty: 'Правила с такими условиями не найдены.',
    }
  : locale === 'zh'
    ? {
      eyebrow: '机器可读参考',
      title: '校验规则目录',
      lead: `在这个包含 ${catalog.rules.length} 条规则的目录里，按 ID、原则、严重程度和执行方式查找问题及修复方法。`,
      search: '搜索规则',
      searchPlaceholder: '例如：模态框、断点、文本……',
      severityLabel: '严重程度',
      automationLabel: '执行方式',
      severity: '全部严重程度',
      automation: '全部执行方式',
      shown: '显示',
      of: '共',
      loadMore: '加载更多',
      canonical: '为什么会阻碍交付',
      fix: '如何修复',
      empty: '没有符合条件的规则。',
    }
  : {
      eyebrow: 'Machine-readable reference',
      title: 'Validator rule catalog',
      lead: `${catalog.rules.length} rules from validator/rules.json. Filter by ID, principle, severity, and automation level.`,
      search: 'Search rules',
      searchPlaceholder: 'For example: modal, breakpoint, text…',
      severityLabel: 'Severity',
      automationLabel: 'Automation',
      severity: 'Any severity',
      automation: 'Any automation',
      shown: 'Showing',
      of: 'of',
      loadMore: 'Show more',
      canonical: 'Description',
      fix: 'How to fix',
      empty: 'No rules match these filters.',
    };
---

<section class="rules-explorer not-content" data-rules-explorer data-page-size="12">
  <header>
    <p class="bridge-eyebrow">{copy.eyebrow}</p>
    <h1 id="_top">{copy.title}</h1>
    <p>{copy.lead}</p>
  </header>

  <div class="rules-controls">
    <label class="rules-search">
      <span>{copy.search}</span>
      <input type="search" placeholder={copy.searchPlaceholder} data-rule-search />
    </label>
    <label class="rules-select">
      <span>{copy.severityLabel}</span>
      <select data-rule-severity>
        <option value="">{copy.severity}</option>
        {catalog.severityLevels.map((level) => (
          <option value={level}>{locale === 'ru' ? severityRu[level] : locale === 'zh' ? severityZh[level] : level}</option>
        ))}
      </select>
    </label>
    <label class="rules-select">
      <span>{copy.automationLabel}</span>
      <select data-rule-automation>
        <option value="">{copy.automation}</option>
        {catalog.automationLevels.map((level) => (
          <option value={level}>{locale === 'ru' ? automationRu[level] : locale === 'zh' ? automationZh[level] : level}</option>
        ))}
      </select>
    </label>
  </div>

  <div class="rules-meta" aria-live="polite">
    {copy.shown} <strong data-rule-count>12</strong> {copy.of} <strong data-rule-total>{catalog.rules.length}</strong>
  </div>

  <div class="rules-list">
    {catalog.rules.map((rule, index) => {
      const title = locale === 'ru'
        ? (ruRules[rule.id as keyof typeof ruRules]?.title || humanize(rule.id))
        : locale === 'zh'
          ? (zhRules[rule.id as keyof typeof zhRules]?.title || humanize(rule.id))
          : humanize(rule.id);
      const localizedRule = locale === 'ru'
        ? ruRules[rule.id as keyof typeof ruRules]
        : locale === 'zh'
          ? zhRules[rule.id as keyof typeof zhRules]
          : undefined;
      const searchable = [
        rule.id,
        title,
        locale === 'ru' ? russianSearchAliases(rule.id) : locale === 'zh' ? chineseSearchAliases(rule.id) : '',
        rule.principle,
        rule.severity,
        rule.automation,
        localizedRule?.description || rule.description,
        localizedRule?.fix || rule.fix,
      ].join(' ').toLowerCase();
      return (
        <article
          id={rule.id}
          class={`rule-card rule-${rule.severity}`}
          tabindex="-1"
          data-rule
          data-severity={rule.severity}
          data-automation={rule.automation}
          data-search={searchable}
          hidden={index >= 12}
        >
          <div class="rule-card-head">
            <div>
              <code>{rule.id}</code>
              <h2>{title}</h2>
            </div>
            <div class="rule-badges">
              <span>{locale === 'ru' ? (principleRu[rule.principle] || rule.principle) : locale === 'zh' ? (principleZh[rule.principle] || rule.principle) : rule.principle}</span>
              <span>{locale === 'ru' ? severityRu[rule.severity] : locale === 'zh' ? severityZh[rule.severity] : rule.severity}</span>
              <span>{locale === 'ru' ? automationRu[rule.automation] : locale === 'zh' ? automationZh[rule.automation] : rule.automation}</span>
            </div>
          </div>
          {locale === 'en' ? (
            <><p>{rule.description}</p><div class="rule-fix"><strong>{copy.fix}</strong><p>{rule.fix}</p></div></>
          ) : (
            <details>
              <summary>{copy.canonical}</summary>
              <p>{localizedRule?.description}</p>
              <div class="rule-fix"><strong>{copy.fix}</strong><p>{localizedRule?.fix}</p></div>
            </details>
          )}
        </article>
      );
    })}
  </div>

  <div class="rules-more">
    <button class="bridge-button bridge-button-secondary" type="button" data-rule-more>{copy.loadMore}</button>
  </div>

  <p class="rules-empty" data-rules-empty hidden>{copy.empty}</p>
</section>

<script>
  const initializeRuleExplorer = (root: Element) => {
    if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const search = root.querySelector('[data-rule-search]');
    const severity = root.querySelector('[data-rule-severity]');
    const automation = root.querySelector('[data-rule-automation]');
    const cards = [...root.querySelectorAll('[data-rule]')];
    const count = root.querySelector('[data-rule-count]');
    const total = root.querySelector('[data-rule-total]');
    const more = root.querySelector('[data-rule-more]');
    const empty = root.querySelector('[data-rules-empty]');
    const pageSize = Number(root.dataset.pageSize || 12);
    let limit = pageSize;

    const ruleFromHash = () => {
      if (!window.location.hash) return '';
      try {
        return decodeURIComponent(window.location.hash.slice(1)).trim().toLowerCase();
      } catch {
        return '';
      }
    };

    const cardWithId = (id: string) => cards.find((card) => card instanceof HTMLElement && card.id === id);

    const filter = () => {
      const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
      const severityValue = severity instanceof HTMLSelectElement ? severity.value : '';
      const automationValue = automation instanceof HTMLSelectElement ? automation.value : '';
      let matching = 0;
      let visible = 0;

      for (const card of cards) {
        if (!(card instanceof HTMLElement)) continue;
        const matches = (!query || card.dataset.search?.includes(query))
          && (!severityValue || card.dataset.severity === severityValue)
          && (!automationValue || card.dataset.automation === automationValue);
        if (matches) matching += 1;
        const isVisible = Boolean(matches) && visible < limit;
        card.hidden = !isVisible;
        if (isVisible) visible += 1;
      }

      if (count) count.textContent = String(visible);
      if (total) total.textContent = String(matching);
      if (empty instanceof HTMLElement) empty.hidden = matching !== 0;
      if (more instanceof HTMLButtonElement) more.hidden = visible >= matching;
    };

    const resetAndFilter = () => {
      limit = pageSize;
      filter();
    };

    search?.addEventListener('input', resetAndFilter);
    severity?.addEventListener('change', resetAndFilter);
    automation?.addEventListener('change', resetAndFilter);
    more?.addEventListener('click', () => {
      limit += pageSize;
      filter();
    });

    const revealRuleFromLocation = (moveFocus = false) => {
      const ruleId = ruleFromHash();
      const target = cardWithId(ruleId);
      if (!(target instanceof HTMLElement)) return false;
      if (search instanceof HTMLInputElement) search.value = ruleId;
      if (severity instanceof HTMLSelectElement) severity.value = '';
      if (automation instanceof HTMLSelectElement) automation.value = '';
      limit = cards.length;
      filter();
      requestAnimationFrame(() => {
        target.scrollIntoView({ block: 'center' });
        if (moveFocus) target.focus({ preventScroll: true });
      });
      return true;
    };

    if (!revealRuleFromLocation()) {
      const initialQuery = new URLSearchParams(window.location.search).get('q')?.trim() || '';
      if (initialQuery && search instanceof HTMLInputElement) search.value = initialQuery;
      filter();
    }
    window.addEventListener('hashchange', () => revealRuleFromLocation(true));
  };

  for (const root of document.querySelectorAll('[data-rules-explorer]')) initializeRuleExplorer(root);
</script>
