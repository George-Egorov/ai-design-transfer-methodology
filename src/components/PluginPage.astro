---
interface Props {
  locale: 'ru' | 'en' | 'zh';
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const url = (path: string) => `${base}/${locale}/${path.replace(/^\//u, '')}`;
const pluginUrl = 'https://www.figma.com/community/plugin/1654485530503673254/bridge';

const copy = locale === 'ru'
  ? {
      eyebrow: 'Проверка макета',
      title: 'Выберите способ проверки.',
      lead: 'Запустите проверку в Figma, пройдите короткий чеклист или откройте полный аудит для команды.',
      navLabel: 'Способы проверки',
      designer: 'Чеклист дизайнера',
      full: 'Полная проверка',
      plugin: 'Проверка в Figma',
      pluginEyebrow: 'Помощник в Figma',
      pluginTitle: 'Проверьте макет прямо в файле.',
      pluginLead: 'Плагин помогает добавить смысл слоям, увидеть карту файла и перейти от замечания к точному месту.',
      open: 'Открыть плагин BRIDGE',
      capabilitiesLabel: 'Что делает плагин',
      capabilities: [
        ['Добавляет смысл', 'Помогает разметить слой без ручного набора синтаксиса.'],
        ['Показывает карту', 'Показывает страницы, цели и места, требующие решения.'],
        ['Находит пробелы', 'Открывает нужный слой и объясняет, что исправить.'],
      ],
      trust: 'Доступен через Figma Community · отдельный аккаунт BRIDGE не нужен',
      newTab: 'откроется в новой вкладке',
    }
  : locale === 'zh'
    ? {
      eyebrow: '检查设计',
      title: '选择检查方式。',
      lead: '在 Figma 中运行检查，使用简短清单，或为团队打开完整审核。',
      navLabel: '检查方式',
      designer: '设计师清单',
      full: '完整检查',
      plugin: '在 Figma 中检查',
      pluginEyebrow: 'Figma 助手',
      pluginTitle: '直接在文件中检查设计。',
      pluginLead: '插件帮助为图层添加含义、查看文件地图，并从问题跳到相关位置。',
      open: '打开 BRIDGE 插件',
      capabilitiesLabel: '插件功能',
      capabilities: [
        ['添加含义', '无需手工拼接语法即可标记图层。'],
        ['查看地图', '展示页面、目标和仍需决定的位置。'],
        ['发现缺口', '打开相关图层并说明需要修正的内容。'],
      ],
      trust: '可从 Figma Community 获取 · 不需要 BRIDGE 账号',
      newTab: '将在新标签页打开',
    }
  : {
      eyebrow: 'Design check',
      title: 'Choose a way to check the design.',
      lead: 'Run the check in Figma, use the short checklist, or open the full audit for the team.',
      navLabel: 'Review options',
      designer: 'Designer checklist',
      full: 'Full review',
      plugin: 'Check in Figma',
      pluginEyebrow: 'Figma companion',
      pluginTitle: 'Check the design directly in the file.',
      pluginLead: 'The plugin helps add meaning to layers, see the file map, and move from an issue to the exact place.',
      open: 'Open BRIDGE plugin',
      capabilitiesLabel: 'What the plugin does',
      capabilities: [
        ['Add meaning', 'Helps tag a layer without handwritten syntax.'],
        ['Show the map', 'Shows pages, targets, and places that need a decision.'],
        ['Find gaps', 'Opens the affected layer and explains what to fix.'],
      ],
      trust: 'Available from Figma Community · no separate BRIDGE account required',
      newTab: 'opens in a new tab',
    };
---

<div class="plugin-page check-hub not-content">
  <section class="check-hub-hero" aria-labelledby="_top">
    <p class="bridge-eyebrow">{copy.eyebrow}</p>
    <h1 id="_top">{copy.title}</h1>
    <p>{copy.lead}</p>
    <nav aria-label={copy.navLabel}>
      <a href="#figma-page-check"><span aria-hidden="true">→</span>{copy.plugin}</a>
      <a href={url('check/designer-checklist/')}><span aria-hidden="true">→</span>{copy.designer}</a>
      <a href={url('check/full-review/')}><span aria-hidden="true">→</span>{copy.full}</a>
    </nav>
  </section>

  <section id="figma-page-check" class="plugin-brief" aria-labelledby="plugin-title">
    <div class="plugin-brief-copy">
      <p class="bridge-eyebrow">{copy.pluginEyebrow}</p>
      <h2 id="plugin-title">{copy.pluginTitle}</h2>
      <p class="plugin-brief-lead">{copy.pluginLead}</p>
      <a
        class="plugin-brief-cta bridge-button bridge-button-primary"
        href={pluginUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        {copy.open}<span aria-hidden="true"> ↗</span><span class="sr-only"> — {copy.newTab}</span>
      </a>
    </div>

    <ul class="plugin-capabilities" aria-label={copy.capabilitiesLabel}>
      {copy.capabilities.map(([title, description], index) => (
        <li>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <strong>{title}</strong>
          <p>{description}</p>
        </li>
      ))}
    </ul>

    <footer class="plugin-brief-meta">
      <p>{copy.trust}</p>
    </footer>

  </section>
</div>
