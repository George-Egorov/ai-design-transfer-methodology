---
interface Props {
  locale: 'ru' | 'en' | 'zh';
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const url = (path: string) => `${base}/${locale}/${path.replace(/^\//u, '')}`;
const pluginUrl = 'https://www.figma.com/community/plugin/1654485530503673254/bridge';

const copy = locale === 'ru'
  ? {
      eyebrow: 'Центр проверки',
      title: 'Проверьте макет в три шага.',
      lead: 'Откройте чеклист, полный review или сам плагин BRIDGE. Здесь только понятные маршруты — без имитации проверки в браузере.',
      navLabel: 'Способы проверки',
      designer: 'Чеклист дизайнера',
      full: 'Полный review',
      plugin: 'Page Check в Figma',
      pluginEyebrow: 'Помощник в Figma',
      pluginTitle: 'Проверяйте ту же систему прямо в файле.',
      pluginLead: 'Плагин помогает разметить файл, увидеть его карту и перейти от вопроса к точному слою и правилу.',
      open: 'Figma plugin BRIDGE',
      capabilitiesLabel: 'Что делает плагин',
      capabilities: [
        ['Разметка', 'Помогает добавить смысл слою без ручного набора синтаксиса.'],
        ['Карта', 'Показывает страницы, цели и места, которые ещё требуют решения.'],
        ['Проверка', 'Находит пробелы и открывает затронутый слой с объяснением.'],
      ],
      trust: 'Доступен через Figma Community · аккаунт BRIDGE не нужен',
      privateTitle: 'Что открыто, а что нет',
      privateNote: 'Методология BRIDGE, документация, чеклисты и каталог правил открыты. Реализация Figma-плагина — частная; публичного репозитория, issue tracker и ленты релизов для неё нет.',
      rules: 'Открыть каталог правил',
      newTab: 'откроется в новой вкладке',
    }
  : locale === 'zh'
    ? {
      eyebrow: '方法论工具',
      title: '用三个步骤检查设计。',
      lead: '打开设计师清单、完整检查或 BRIDGE 插件。这里提供清晰的入口，而不是在浏览器中模拟检查。',
      navLabel: '检查方式',
      designer: '设计师清单',
      full: '完整检查',
      plugin: '在 Figma 中检查',
      pluginEyebrow: 'Figma 助手',
      pluginTitle: '直接在文件中检查同一套设计。',
      pluginLead: '插件帮助标记文件、查看文件地图，并从问题直接跳到相关图层和规则。',
      open: 'Figma 插件 BRIDGE',
      capabilitiesLabel: '插件功能',
      capabilities: [
        ['标签', '帮助为图层添加含义，无需手工拼接语法。'],
        ['地图', '展示页面、目标和仍需决定的位置。'],
        ['检查', '发现缺口并打开相关图层和解释。'],
      ],
      trust: '本地运行于 Figma · 不需要 BRIDGE 账号 · 无网络访问',
      privateTitle: '哪些内容是公开的',
      privateNote: 'BRIDGE 方法论、文档、清单和规则目录公开。Figma 插件实现是私有的。',
      rules: '打开规则目录',
      source: '源代码',
      newTab: '将在新标签页打开',
    }
  : {
      eyebrow: 'Review hub',
      title: 'Review the design in three steps.',
      lead: 'Open the designer checklist, the full review, or the BRIDGE plugin. These are clear routes—not a browser simulation of a real file check.',
      navLabel: 'Review options',
      designer: 'Designer checklist',
      full: 'Full review',
      plugin: 'Page Check in Figma',
      pluginEyebrow: 'Figma companion',
      pluginTitle: 'Review the same system directly in the file.',
      pluginLead: 'The plugin helps tag the file, see its map, and move from a question to the exact layer and rule.',
      open: 'Figma plugin BRIDGE',
      capabilitiesLabel: 'What the plugin does',
      capabilities: [
        ['Tag', 'Helps add meaning to a layer without handwritten syntax.'],
        ['Map', 'Shows pages, targets, and places that still need a decision.'],
        ['Check', 'Finds gaps and opens the affected layer with an explanation.'],
      ],
      trust: 'Available from Figma Community · no BRIDGE account required',
      privateTitle: 'What is open, and what is not',
      privateNote: 'The BRIDGE methodology, documentation, checklists, and rule catalog are open. The Figma plugin implementation is private; it has no public source repository, issue tracker, or release feed.',
      rules: 'Open rule catalog',
      newTab: 'opens in a new tab',
    };
---

<div class="plugin-page check-hub not-content">
  <section class="check-hub-hero" aria-labelledby="_top">
    <p class="bridge-eyebrow">{copy.eyebrow}</p>
    <h1 id="_top">{copy.title}</h1>
    <p>{copy.lead}</p>
    <nav aria-label={copy.navLabel}>
      <a href={url('check/designer-checklist/')}><span>01</span>{copy.designer}</a>
      <a href={url('check/full-review/')}><span>02</span>{copy.full}</a>
      <a href="#figma-page-check"><span>03</span>{copy.plugin}</a>
    </nav>
  </section>

  <section id="figma-page-check" class="plugin-brief" aria-labelledby="plugin-title">
    <div class="plugin-brief-copy">
      <p class="bridge-eyebrow">{copy.pluginEyebrow}</p>
      <h2 id="plugin-title">{copy.pluginTitle}</h2>
      <p class="plugin-brief-lead">{copy.pluginLead}</p>
      <a
        class="plugin-brief-cta bridge-button bridge-button-primary"
        href={pluginUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        {copy.open}<span aria-hidden="true"> ↗</span><span class="sr-only"> — {copy.newTab}</span>
      </a>
    </div>

    <ul class="plugin-capabilities" aria-label={copy.capabilitiesLabel}>
      {copy.capabilities.map(([title, description], index) => (
        <li>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <strong>{title}</strong>
          <p>{description}</p>
        </li>
      ))}
    </ul>

    <footer class="plugin-brief-meta">
      <p>{copy.trust}</p>
    </footer>

    <aside class="plugin-private-note" aria-labelledby="plugin-private-title">
      <div>
        <span aria-hidden="true">※</span>
        <h3 id="plugin-private-title">{copy.privateTitle}</h3>
      </div>
      <p>{copy.privateNote}</p>
      <a href={url('rules/')}>{copy.rules}<span aria-hidden="true"> →</span></a>
    </aside>
  </section>
</div>
