    ? {
      eyebrow: '设计需要回答的六个问题',
      title: '设计与代码之间不应出现未解释的决策。',
      lead: 'BRIDGE 把六个简单问题收拢成一份清晰计划。点开任一问题，查看设计需要说明什么。',
      modelNote: '这不是技术词典，也不意味着所有答案都已知。它是一份帮助团队保留重要决策的实用清单。',
      tabsLabel: 'BRIDGE 六个问题',
      coreLabel: '个问题对应一份设计',
      channel: '问题',
      proofLabel: '规则不适用时',
      proof: '有意的偏离要和原因一起记录，而不是只留在作者记忆中。',
      proofEvidence: '示例：偏离与原因',
      structureRule: '详细的结构规则请查看文档。',
      structureRuleAction: '打开详细规则',
      items: [
        {
          id: 'structure',
          english: 'Structure',
          translation: '结构',
          source: '图层与关系',
          title: '从图层理解设计。',
          description: '结构应能从图层和关系中读懂，而不是依赖作者解释。',
          evidence: '示例：首页 · 1440 px',
          checks: ['清晰的图层和关系', '合理的顺序', '不同宽度保持同一逻辑'],
        },
        {
          id: 'data',
          english: 'Data',
          translation: '数据',
          source: '真实内容',
          title: '展示真实的数据变化。',
          description: '设计要考虑长、短、空和本地化内容，而不只是一个漂亮示例。',
          evidence: '示例：短文本 · 长文本 · 空内容',
          checks: ['长和短文本', '空内容与边界情况', '图片和格式'],
        },
        {
          id: 'state',
          english: 'State',
          translation: '状态',
          source: '界面变化',
          title: '说明动作之后会发生什么。',
          description: '默认、空、加载、错误和动作反馈状态应在实现前展示清楚。',
          evidence: '示例：加载 → 完成 → 错误',
          checks: ['动作之前', '动作进行中', '动作之后'],
        },
        {
          id: 'responsive',
          english: 'Responsive',
          translation: '响应式',
          source: '不同宽度',
          title: '展示不同宽度下的同一页面。',
          description: '尺寸和顺序可以变化，但元素的含义和关系应保持清晰。',
          evidence: '示例：375 · 768 · 1440 px',
          checks: ['宽屏和窄屏', '哪些内容会变化', '哪些内容保持不变'],
        },
        {
          id: 'motion',
          english: 'Motion',
          translation: '动效',
          source: '动画和滚动',
          title: '解释动效如何工作。',
          description: '动效有原因、时长，也要为偏好减少动画的人提供平静的替代方案。',
          evidence: '示例：滚动时出现区块',
          checks: ['什么触发动效', '动效如何进行', '平静的替代方案'],
        },
        {
          id: 'accessibility',
          english: 'Accessibility',
          translation: '无障碍',
          source: '清晰和可操作',
          title: '让界面清晰且易于使用。',
          description: '检查名称、键盘操作、焦点、对比度和交互元素的尺寸。',
          evidence: '示例：键盘 · 对比度 · 焦点',
          checks: ['清晰的名称', '键盘和焦点', '对比度和目标尺寸'],
        },
      ],
    }
  : {
      eyebrow: 'Six questions for every design',
      title: 'No decision should disappear between design and code.',
      lead: 'BRIDGE brings six simple questions into one clear plan. Select a question to see what the design needs to answer.',
      modelNote: 'This is not a technical glossary or a promise that every answer is already known. It is a practical list of questions that keeps important decisions visible.',
      tabsLabel: 'Six BRIDGE questions',
      coreLabel: 'questions for one design',
      channel: 'Question',
      proofLabel: 'When a rule does not fit',
      proof: 'An intentional deviation is recorded with its reason instead of staying only in the author’s head.',
      proofEvidence: 'Example: a deviation with its reason',
      structureRule: 'Detailed structure rules are available in the documentation.',
      structureRuleAction: 'Open detailed rules',
      items: [
        {
          id: 'structure',
          english: 'Structure',
          translation: '',
          source: 'Layers and relationships',
          title: 'Understand the design from its layers.',
          description: 'The structure should be readable from layers and relationships, not from a call with the author.',
          evidence: 'Example: home page · 1440 px',
          checks: ['clear layers and relationships', 'logical order', 'same logic across widths'],
        },
        {
          id: 'data',
          english: 'Data',
          translation: '',
          source: 'Real content',
          title: 'Show real variations of the data.',
          description: 'The design accounts for long, short, empty, and localized content—not only one polished example.',
          evidence: 'Example: short · long · empty text',
          checks: ['long and short text', 'empty and edge cases', 'images and formats'],
        },
        {
          id: 'state',
          english: 'State',
          translation: '',
          source: 'Interface changes',
          title: 'Show what happens after an action.',
          description: 'Default, empty, loading, error, and action-response states should be visible before implementation starts.',
          evidence: 'Example: loading → ready → error',
          checks: ['before the action', 'during the action', 'after the action'],
        },
        {
          id: 'responsive',
          english: 'Responsive',
          translation: '',
          source: 'Different widths',
          title: 'Show one page at different widths.',
          description: 'Size and order may change, but the meaning and relationships between elements should stay clear.',
          evidence: 'Example: 375 · 768 · 1440 px',
          checks: ['wide and narrow screens', 'what changes', 'what stays the same'],
        },
        {
          id: 'motion',
          english: 'Motion',
          translation: '',
          source: 'Animation and scrolling',
          title: 'Explain how movement works.',
          description: 'Motion has a reason, duration, and a calm alternative for people who prefer less animation.',
          evidence: 'Example: block appears on scroll',
          checks: ['what starts the motion', 'how it progresses', 'calm alternative'],
        },
        {
          id: 'accessibility',
          english: 'Accessibility',
          translation: '',
          source: 'Clarity and control',
          title: 'Make the interface clear and usable.',
          description: 'Check names, keyboard control, focus, contrast, and the size of interactive elements.',
          evidence: 'Example: keyboard · contrast · focus',
          checks: ['clear names', 'keyboard and focus', 'contrast and target size'],
        },
      ],
    };
---

<section class="bridge-section bridge-contract" aria-labelledby="bridge-contract-title">
  <header class="bridge-contract-heading">
    <p class="bridge-eyebrow">{copy.eyebrow}</p>
    <div>
      <h2 id="bridge-contract-title">{copy.title}</h2>
      <p>{copy.lead}</p>
    </div>
    <p class="bridge-contract-model-note">{copy.modelNote}</p>
  </header>

  <div class="bridge-coverage-board" data-coverage-map>
    <div class="bridge-coverage-tabs" role="tablist" aria-label={copy.tabsLabel}>
      {copy.items.map((item, index) => (
        <button
          id={`coverage-${item.id}-tab`}
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`coverage-${item.id}-panel`}
          tabindex={index === 0 ? '0' : '-1'}
          data-coverage-tab
          data-coverage-index={index}
        >
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{item.english}</strong>
          {item.translation && <small class="bridge-coverage-translation">{item.translation}</small>}
          <small class="bridge-coverage-source">{item.source}</small>
          <i aria-hidden="true"></i>
        </button>
      ))}
    </div>

    <div class="bridge-coverage-core" aria-hidden="true">
      <img src={`${base}/assets/brand/bridge-mark.svg`} width="72" height="72" alt="" />
      <strong>6 / 6</strong>
      <span>{copy.coreLabel}</span>
    </div>

    <div class="bridge-coverage-panels">
      {copy.items.map((item, index) => (
        <article
          id={`coverage-${item.id}-panel`}
          role="tabpanel"
          aria-labelledby={`coverage-${item.id}-tab`}
          tabindex="0"
          data-coverage-panel
          data-coverage-index={index}
          hidden={index !== 0}
        >
          <p>{copy.channel} {String(index + 1).padStart(2, '0')} / 06</p>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <code>{item.evidence}</code>
          <ul>
            {item.checks.map((check) => <li><span aria-hidden="true"></span>{check}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>

  <a class="bridge-contract-rule" href={`${base}/${locale}/guides/design-rules/`}>
    <span>{copy.structureRule}</span>
    <strong>{copy.structureRuleAction}<span aria-hidden="true"> →</span></strong>
  </a>

  <div class="bridge-contract-proof">
    <div>
      <span>{copy.proofLabel}</span>
      <code>{copy.proofEvidence}</code>
    </div>
    <p>{copy.proof}</p>
  </div>
</section>

<script>
  const initCoverageMap = (root: Element) => {
    if (!(root instanceof HTMLElement) || root.dataset.coverageReady === 'true') return;
    root.dataset.coverageReady = 'true';

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-coverage-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-coverage-panel]')];

    const activate = (tab: HTMLButtonElement, moveFocus = false) => {
      const index = Number(tab.dataset.coverageIndex || 0);
      for (const item of tabs) {
        const active = item === tab;
        item.setAttribute('aria-selected', String(active));
        item.tabIndex = active ? 0 : -1;
      }
      for (const panel of panels) panel.hidden = Number(panel.dataset.coverageIndex || 0) !== index;
      root.style.setProperty('--coverage-active', String(index));
      if (moveFocus) tab.focus();
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        const current = tabs.indexOf(tab);
        let next = -1;
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight') next = (current + 1) % tabs.length;
        if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') next = (current - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') next = 0;
        if (event.key === 'End') next = tabs.length - 1;
        if (next < 0) return;
        event.preventDefault();
        const nextTab = tabs[next];
        if (nextTab) activate(nextTab, true);
      });
    }
  };

  for (const root of document.querySelectorAll('[data-coverage-map]')) initCoverageMap(root);
</script>
