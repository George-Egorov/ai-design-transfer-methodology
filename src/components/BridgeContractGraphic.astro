          checks: ['понятные слои и связи', 'логичный порядок', 'одинаковая логика на ширинах'],
        },
        {
          id: 'data',
          english: 'Data',
          translation: 'Данные',
          source: 'Реальное содержимое',
          title: 'Показать реальные варианты данных.',
          description: 'Макет учитывает длинный, короткий, пустой и локализованный контент, а не только один красивый пример.',
          evidence: 'Пример: короткий · длинный · пустой текст',
          checks: ['длинный и короткий текст', 'пустые и крайние случаи', 'изображения и форматы'],
        },
        {
          id: 'state',
          english: 'State',
          translation: 'Состояния',
          source: 'Изменения интерфейса',
          title: 'Показать, что происходит после действия.',
          description: 'Обычное, пустое, загружаемое, ошибочное состояния и ответ на действие должны быть видны заранее.',
          evidence: 'Пример: загрузка → готово → ошибка',
          checks: ['до действия', 'во время действия', 'после действия'],
        },
        {
          id: 'responsive',
          english: 'Responsive',
          translation: 'Адаптивы',
          source: 'Разные ширины',
          title: 'Показать одну страницу на разных ширинах.',
          description: 'Размеры и порядок могут меняться, но смысл и связь элементов должны оставаться понятными.',
          evidence: 'Пример: 375 · 768 · 1440 px',
          checks: ['широкий и узкий экран', 'что меняется', 'что остаётся тем же'],
        },
        {
          id: 'motion',
          english: 'Motion',
          translation: 'Движение',
          source: 'Анимация и прокрутка',
          title: 'Объяснить, как работает движение.',
          description: 'У движения есть причина, длительность и спокойный вариант для тех, кому анимация мешает.',
          evidence: 'Пример: появление блока при прокрутке',
          checks: ['что запускает движение', 'как оно проходит', 'спокойный вариант'],
        },
        {
          id: 'accessibility',
          english: 'Accessibility',
          translation: 'Доступность',
          source: 'Понятность и управление',
          title: 'Сделать интерфейс понятным и управляемым.',
          description: 'Нужно проверить названия, управление с клавиатуры, фокус, контраст и размеры интерактивных элементов.',
          evidence: 'Пример: клавиатура · контраст · фокус',
