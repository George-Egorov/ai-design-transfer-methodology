---
import registry from '../../validator/tags.json';

interface Props {
  locale: 'ru' | 'en' | 'zh';
}

const { locale } = Astro.props;
type TagStatus = 'stable' | 'experimental' | 'deprecated';
type TagScope = 'page-root' | 'variant-root' | 'layer' | 'control' | 'field' | 'target' | 'collection' | 'item';
type TagForm = 'boolean' | 'property' | 'boolean-or-property';
type Relationship = [label: string, values: string[]];
const copy = locale === 'ru'
  ? {
      eyebrow: `Канонический реестр · схема ${registry.schemaVersion}`,
      title: 'Справочник тегов BRIDGE',
      lead: `${registry.tags.length} тегов с формой записи, областью применения и связями. Стабильные теги можно добавлять в имя слоя; сложные данные, движение и сценарии хранятся в структурированном контракте.`,
      search: 'Поиск по тегу',
      placeholder: 'Например: страница, действие, модальное окно…',
      status: 'Статус',
      allStatuses: 'Любой статус',
      authored: 'Только доступные для записи',
      shown: 'Показано',
      of: 'из',
      scope: 'Где применяется',
      form: 'Форма',
      relations: 'Связи',
      requires: 'обязательны',
      requiresAny: 'нужен один из',
      conflicts: 'несовместимы',
      recommended: 'рекомендуются',
      value: 'Значение',
      noValue: 'без значения',
      empty: 'Теги с такими условиями не найдены.',
      source: 'Источник правды',
      sourceBridge: 'BRIDGE-тег',
      sourceFigma: 'метаданные Figma',
      statuses: { stable: 'Стабильный', experimental: 'Экспериментальный', deprecated: 'Устаревший' },
      forms: { boolean: 'логический', property: 'свойство', 'boolean-or-property': 'логический или свойство' },
      scopes: {
        'page-root': 'корень страницы', 'variant-root': 'корень варианта', layer: 'слой', control: 'элемент управления',
        field: 'поле', target: 'цель', collection: 'коллекция', item: 'элемент коллекции',
      },
    }
  : locale === 'zh'
    ? {
      eyebrow: `规范标签注册表 · schema ${registry.schemaVersion}`,
      title: 'BRIDGE 标签参考',
      lead: `${registry.tags.length} 个标签，包含书写形式、适用范围和关系。稳定标签可以写入图层名称；复杂数据、动效和场景应保存在结构化契约中。`,
      search: '搜索标签',
      placeholder: '例如：页面、动作、模态框……',
      status: '状态',
      allStatuses: '全部状态',
      authored: '仅显示可写入图层名称的标签',
      shown: '显示',
      of: '共',
      scope: '适用范围',
      form: '形式',
      relations: '关系',
      requires: '必须包含',
      requiresAny: '至少需要一个',
      conflicts: '不可同时使用',
      recommended: '建议搭配',
      value: '值',
      noValue: '无值',
      empty: '没有符合条件的标签。',
      source: '真实来源',
      sourceBridge: 'BRIDGE 标签',
      sourceFigma: 'Figma 元数据',
      statuses: { stable: '稳定', experimental: '实验性', deprecated: '已弃用' },
      forms: { boolean: '布尔值', property: '属性', 'boolean-or-property': '布尔值或属性' },
      scopes: {
        'page-root': '页面根节点', 'variant-root': '变体根节点', layer: '图层', control: '控件',
        field: '字段', target: '目标', collection: '集合', item: '集合项',
      },
    }
  : {
      eyebrow: `Canonical registry · schema ${registry.schemaVersion}`,
      title: 'BRIDGE tag reference',
      lead: `${registry.tags.length} tags with authored form, scope, and relationships. Stable tags can be written into layer names; rich data, motion, and scenarios belong in the structured contract.`,
      search: 'Search tags',
      placeholder: 'For example: page, action, modal…',
      status: 'Status',
      allStatuses: 'Any status',
      authored: 'Authored tags only',
      shown: 'Showing',
      of: 'of',
      scope: 'Scope',
      form: 'Form',
      relations: 'Relationships',
      requires: 'requires',
      requiresAny: 'requires one of',
      conflicts: 'conflicts with',
      recommended: 'recommended',
      value: 'Value',
      noValue: 'no value',
      empty: 'No tags match these filters.',
      source: 'Source of truth',
      sourceBridge: 'BRIDGE tag',
      sourceFigma: 'Figma metadata',
      statuses: { stable: 'Stable', experimental: 'Experimental', deprecated: 'Deprecated' },
      forms: { boolean: 'boolean', property: 'property', 'boolean-or-property': 'boolean or property' },
      scopes: {
        'page-root': 'page root', 'variant-root': 'variant root', layer: 'layer', control: 'control',
        field: 'field', target: 'target', collection: 'collection', item: 'collection item',
      },
    };

const formatExample = (tag: (typeof registry.tags)[number]) => {
  if (tag.form === 'boolean') return `[${tag.key}]`;
  const value = tag.value;
  const sample = value && 'enum' in value && value.enum?.[0]
    ? value.enum[0]
    : value?.kind === 'positive-integer' ? '1440'
      : value?.kind === 'route' ? '/catalog'
        : value?.kind === 'href' ? '/contacts'
          : value?.kind === 'action' ? 'modal:contact-modal'
            : value?.kind === 'locale' ? 'ru-RU'
              : tag.key === 'a11y-label' ? 'Open menu'
                : 'value';
  return tag.form === 'boolean-or-property' ? `[${tag.key}] · [${tag.key}=${sample}]` : `[${tag.key}=${sample}]`;
};

const relationships = (tag: (typeof registry.tags)[number]): Relationship[] => {
  const companions = tag.companions as Partial<Record<'requires' | 'requiresAny' | 'conflicts' | 'recommended', string[]>>;
  return [
    [copy.requires, companions.requires],
    [copy.requiresAny, companions.requiresAny],
    [copy.conflicts, companions.conflicts],
    [copy.recommended, companions.recommended],
  ].filter((item): item is Relationship => Array.isArray(item[1]) && item[1].length > 0);
};

const russianAliases: Record<string, string> = {
  page: 'страница экран', bp: 'брейкпоинт адаптив ширина', view: 'состояние страницы',
  href: 'ссылка адрес переход', action: 'действие кнопка реакция', control: 'элемент управления кнопка',
  modal: 'модальное окно модалка диалог', state: 'состояние', form: 'форма отправка', field: 'поле ввод',
  collection: 'коллекция список сетка', item: 'элемент карточка строка', decor: 'декор декоративный',
  asset: 'ресурс экспорт изображение', 'a11y-label': 'доступность подпись имя',
  'bridge-exception': 'исключение отклонение', reason: 'причина обоснование',
};
---

<section class="tag-registry not-content" data-tag-registry>
  <header>
    <p class="bridge-eyebrow">{copy.eyebrow}</p>
    <h1 id="_top">{copy.title}</h1>
    <p>{copy.lead}</p>
  </header>

  <div class="tag-controls">
    <label class="tag-search">
      <span>{copy.search}</span>
      <input type="search" placeholder={copy.placeholder} data-tag-search />
    </label>
    <label class="tag-select">
      <span>{copy.status}</span>
      <select data-tag-status>
        <option value="">{copy.allStatuses}</option>
        {registry.statusLevels.map((status) => <option value={status}>{copy.statuses[status as TagStatus]}</option>)}
      </select>
    </label>
    <label class="tag-authored">
      <input type="checkbox" data-tag-authored />
      <span>{copy.authored}</span>
    </label>
  </div>

  <p class="tag-meta" aria-live="polite">{copy.shown} <strong data-tag-count>{registry.tags.length}</strong> {copy.of} {registry.tags.length}</p>

  <div class="tag-grid">
    {registry.tags.map((tag) => {
      const title = tag.title[locale];
      const notes = 'notes' in tag ? tag.notes?.[locale] : undefined;
      const searchable = [tag.key, title, notes, locale === 'ru' ? russianAliases[tag.key] : '', ...tag.scope.map((scope) => copy.scopes[scope as TagScope])].filter(Boolean).join(' ').toLowerCase();
      const relations = relationships(tag);
      return (
        <article class:list={['tag-card', `is-${tag.status}`]} data-tag data-status={tag.status} data-authored={String(tag.authoredInLayerName)} data-search={searchable}>
          <header>
            <code>{formatExample(tag)}</code>
            <span>{copy.statuses[tag.status as TagStatus]}</span>
          </header>
          <h2>{title}</h2>
          {notes && <p>{notes}</p>}
          <dl>
            <div><dt>{copy.source}</dt><dd>{tag.sourceOfTruth === 'bridge-tag' ? copy.sourceBridge : copy.sourceFigma}</dd></div>
            <div><dt>{copy.scope}</dt><dd>{tag.scope.map((scope) => copy.scopes[scope as TagScope]).join(' · ')}</dd></div>
            <div><dt>{copy.form}</dt><dd>{copy.forms[tag.form as TagForm]}</dd></div>
            <div><dt>{copy.value}</dt><dd>{tag.value ? tag.value.kind : copy.noValue}</dd></div>
          </dl>
          {relations.length > 0 && (
            <div class="tag-relations">
              <strong>{copy.relations}</strong>
              <ul>{relations.map(([label, values]) => <li><span>{label}</span> {values?.map((value) => <code>[{value}]</code>)}</li>)}</ul>
            </div>
          )}
        </article>
      );
    })}
  </div>

  <p class="tag-empty" data-tag-empty hidden>{copy.empty}</p>
</section>

<script>
  const initTagRegistry = (root: Element) => {
    if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const search = root.querySelector<HTMLInputElement>('[data-tag-search]');
    const status = root.querySelector<HTMLSelectElement>('[data-tag-status]');
    const authored = root.querySelector<HTMLInputElement>('[data-tag-authored]');
    const cards = [...root.querySelectorAll<HTMLElement>('[data-tag]')];
    const count = root.querySelector('[data-tag-count]');
    const empty = root.querySelector<HTMLElement>('[data-tag-empty]');
    const filter = () => {
      const query = search?.value.trim().toLowerCase() || '';
      const statusValue = status?.value || '';
      let visible = 0;
      for (const card of cards) {
        const matches = (!query || card.dataset.search?.includes(query))
          && (!statusValue || card.dataset.status === statusValue)
          && (!authored?.checked || card.dataset.authored === 'true');
        card.hidden = !matches;
        if (matches) visible += 1;
      }
      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
    };
    search?.addEventListener('input', filter);
    status?.addEventListener('change', filter);
    authored?.addEventListener('change', filter);
  };
  for (const root of document.querySelectorAll('[data-tag-registry]')) initTagRegistry(root);
</script>
