{
  "name": "bridge-design-methodology",
  "version": "0.11.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content:sync": "node scripts/sync-site-content.mjs",
    "lint:ru": "node scripts/check-russian-copy.mjs",
    "lint:rules": "node scripts/check-rule-localization.mjs",
    "lint:locale": "node scripts/check-locale-coverage.mjs",
    "lint:docs": "node scripts/check-doc-concision.mjs",
    "lint:coverage": "node scripts/check-page-check-coverage.mjs && node scripts/check-section-check-coverage.mjs",
    "predev": "npm run content:sync",
    "dev": "astro dev",
    "prebuild": "npm run content:sync",
    "build": "astro build",
    "check": "npm run content:sync && npm run lint:contracts && npm run lint:ru && npm run lint:rules && npm run lint:locale && npm run lint:docs && npm run lint:coverage && npm run lint:links && npm run content:check && astro check",
    "preview": "astro preview",
    "test": "npm run check && npm run build && npm run content:check && npm run lint:built",
    "test:e2e": "playwright test",
    "serve:test": "node scripts/serve-dist.mjs",
    "content:check": "node scripts/sync-site-content.mjs --check",
    "lint:contracts": "node scripts/check-validator-contracts.mjs",
    "lint:links": "node scripts/check-links.mjs",
    "lint:built": "node scripts/check-built-site.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.7",
    "@fontsource-variable/golos-text": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.2.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "6.0.3"
  }
}
